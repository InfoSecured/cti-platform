{
  "name": "cyber-threat-intelligence-platform",
  "main": "src/index.js",
  "compatibility_date": "2025-10-19",

  // Serve built frontend files at the root path:
  "assets": { "directory": "frontend" },

  "kv_namespaces": [
    { "binding": "CTI_CACHE", "id": "933970b23431435f953a911983c658e3" }
  ],
  "durable_objects": {
    "bindings": [ { "name": "IOC_STORAGE", "class_name": "IOCStorage" } ]
  },
  "migrations": [
    { "tag": "v1", "new_classes": ["IOCStorage"] }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "PLATFORM_NAME": "CTI Platform",
    "CROWDSTRIKE_BASE_URL": "https://api.crowdstrike.com"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 100,
      "invocation_logs": true,
      "persist": true
    }
  }
}